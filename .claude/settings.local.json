{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(./mvnw test:*)",
      "Bash(./mvnw.cmd test:*)",
      "mcp__context7__query-docs",
      "Bash(mvn clean install:*)",
      "Bash(docker logs:*)",
      "Bash(docker-compose build:*)",
      "Bash(docker-compose up:*)",
      "Bash(docker exec:*)",
      "Bash(docker run --rm --entrypoint sh back-backend -c \"ls -la /app/\")",
      "Bash(docker run:*)",
      "Bash(curl:*)",
      "Bash(python:*)",
      "mcp__nuxt-ui__get-component",
      "mcp__nuxt-ui__get-example",
      "mcp__nuxt-ui__get-component-metadata",
      "mcp__nuxt-ui__list-examples",
      "mcp__nuxt-ui__search-icons",
      "mcp__nuxt-ui__get-documentation-page",
      "mcp__nuxt-ui__search-documentation",
      "Bash(npx nuxi build)",
      "mcp__context7__resolve-library-id",
      "mcp__nuxt-ui__search-components",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "Bash(npm run build-keycloak-theme:*)"
    ]
  },
  "enabledMcpjsonServers": ["nuxt-ui"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
