{
  "version": "1.0",
  "description": "Skill activation triggers for Claude Code. Controls when skills automatically suggest or block actions.",
  "skills": {
      "skill-developer": {
          "type": "domain",
          "enforcement": "suggest",
          "priority": "high",
          "description": "Meta-skill for creating and managing Claude Code skills",
          "promptTriggers": {
              "keywords": [
                  "skill system",
                  "create skill",
                  "add skill",
                  "skill triggers",
                  "skill rules",
                  "hook system",
                  "skill development",
                  "skill-rules.json"
              ],
              "intentPatterns": [
                  "(how do|how does|explain).*?skill",
                  "(create|add|modify|build).*?skill",
                  "skill.*?(work|trigger|activate|system)"
              ]
          }
      },
      "kotlin-spring-boot-backend": {
          "type": "domain",
          "enforcement": "suggest",
          "priority": "high",
          "description": "Kotlin/Spring Boot backend development with DDD patterns, Exposed ORM, and feature-based architecture",
          "promptTriggers": {
              "keywords": [
                  "backend",
                  "backend development",
                  "Kotlin",
                  "Spring Boot",
                  "controller",
                  "service",
                  "repository",
                  "route",
                  "routing",
                  "API",
                  "endpoint",
                  "RequestMapping",
                  "validation",
                  "database access",
                  "dependency injection",
                  "configuration",
                  "REST API",
                  "HTTP",
                  "Exposed ORM",
                  "DDD",
                  "domain driven design",
                  "aggregate",
                  "value object",
                  "feature",
                  "Flyway",
                  "migration",
                  "JWT",
                  "authentication"
              ],
              "intentPatterns": [
                  "(create|add|implement|build).*?(route|endpoint|API|controller|service|repository|feature)",
                  "(fix|handle|debug).*?(error|exception|backend)",
                  "(add|implement).*?(validation|error.*?handling|JWT|authentication)",
                  "(organize|structure|refactor).*?(backend|service|API|Kotlin|feature)",
                  "(how to|best practice).*?(backend|route|controller|service|Kotlin|DDD|aggregate)",
                  "(create|add).*?(aggregate|value object|domain model)"
              ]
          },
          "fileTriggers": {
              "pathPatterns": [
                  "back/src/**/*.kt",
                  "backend/src/**/*.kt",
                  "src/main/kotlin/**/*.kt",
                  "**/features/**/*.kt"
              ],
              "pathExclusions": [
                  "**/*Test.kt",
                  "**/*Tests.kt",
                  "**/test/**/*.kt"
              ],
              "contentPatterns": [
                  "@RestController",
                  "@Service",
                  "@Repository",
                  "@RequestMapping",
                  "@GetMapping",
                  "@PostMapping",
                  "@PutMapping",
                  "@DeleteMapping",
                  "class.*Controller",
                  "class.*Service",
                  "class.*Repository",
                  "object.*:.*Table",
                  "transaction\\s*\\{"
              ]
          }
      },
      "frontend-dev-guidelines": {
          "type": "domain",
          "enforcement": "suggest",
          "priority": "high",
          "description": "Vue 3 frontend best practices with TypeScript and Tailwind CSS",
          "promptTriggers": {
              "keywords": [
                  "component",
                  "Vue component",
                  "UI",
                  "interface",
                  "page",
                  "modal",
                  "dialog",
                  "form",
                  "Vue",
                  "Vue 3",
                  "Tailwind",
                  "styling",
                  "frontend",
                  "composition API"
              ],
              "intentPatterns": [
                  "(create|add|make|build|update|modify|edit).*?(component|UI|page|modal|dialog|form)",
                  "(how to|best practice).*?(component|Vue|composition API)",
                  "(style|design|layout).*?(component|UI|Tailwind)"
              ]
          },
          "fileTriggers": {
              "pathPatterns": [
                  "frontend/src/**/*.vue",
                  "frontend/src/**/*.ts",
                  "client/src/**/*.vue",
                  "client/src/**/*.ts",
                  "src/**/*.vue"
              ],
              "pathExclusions": [
                  "**/*.test.ts",
                  "**/*.spec.ts",
                  "**/vite.config.ts",
                  "**/tsconfig.json"
              ],
              "contentPatterns": [
                  "<template>",
                  "<script setup",
                  "defineProps",
                  "defineEmits",
                  "class=.*tw-",
                  "@apply"
              ]
          }
      },
      "route-tester": {
          "type": "domain",
          "enforcement": "suggest",
          "priority": "high",
          "description": "Testing authenticated API routes with JWT cookie-based auth",
          "promptTriggers": {
              "keywords": [
                  "test route",
                  "test endpoint",
                  "test API",
                  "route testing",
                  "API testing",
                  "authenticated route",
                  "JWT testing",
                  "cookie auth",
                  "test with auth"
              ],
              "intentPatterns": [
                  "(test|debug|verify).*?(route|endpoint|API)",
                  "(how to|how do I).*?test.*?(route|endpoint|API)",
                  "test.*?(authenticated|auth|JWT|cookie)"
              ]
          },
          "fileTriggers": {
              "pathPatterns": [
                  "**/routes/**/*.ts",
                  "**/test-*.js",
                  "**/test-*.ts"
              ],
              "contentPatterns": [
                  "router\\.(get|post|put|delete|patch)",
                  "app\\.(get|post|put|delete|patch)"
              ]
          }
      },
      "error-tracking": {
          "type": "domain",
          "enforcement": "suggest",
          "priority": "high",
          "description": "Sentry error tracking and performance monitoring patterns",
          "promptTriggers": {
              "keywords": [
                  "error handling",
                  "exception",
                  "sentry",
                  "error tracking",
                  "captureException",
                  "monitoring",
                  "performance tracking"
              ],
              "intentPatterns": [
                  "(add|create|implement|setup).*?(error handling|sentry|error tracking)",
                  "(fix|handle|catch).*?(error|exception)",
                  "(how to|best practice).*?(error|sentry|monitoring)"
              ]
          },
          "fileTriggers": {
              "pathPatterns": [
                  "**/instrument.ts",
                  "**/sentry*.ts",
                  "**/*Controller.ts",
                  "**/*Service.ts"
              ],
              "contentPatterns": [
                  "@sentry",
                  "Sentry\\.",
                  "captureException",
                  "captureMessage"
              ]
          }
      },
      "keycloak": {
          "type": "domain",
          "enforcement": "suggest",
          "priority": "high",
          "description": "Keycloak identity and access management expertise for server setup, realm management, clustering, and admin client usage",
          "promptTriggers": {
              "keywords": [
                  "keycloak",
                  "identity provider",
                  "IAM",
                  "identity and access management",
                  "SSO",
                  "single sign-on",
                  "realm",
                  "keycloak server",
                  "authentication",
                  "authorization",
                  "OAuth2",
                  "OpenID Connect",
                  "OIDC",
                  "user federation",
                  "LDAP",
                  "SAML",
                  "client credentials",
                  "access token",
                  "refresh token",
                  "keycloak admin",
                  "KeycloakBuilder",
                  "RealmRepresentation",
                  "infinispan",
                  "clustering",
                  "standalone",
                  "domain mode",
                  "keycloak deployment"
              ],
              "intentPatterns": [
                  "(setup|install|configure|deploy).*?(keycloak|identity provider|SSO)",
                  "(create|manage|configure).*?(realm|client|user).*?keycloak",
                  "(how to|how do I).*?keycloak.*?(setup|configure|create|manage)",
                  "(integrate|connect).*?keycloak",
                  "(clustering|high availability).*?keycloak",
                  "keycloak.*?(admin|API|REST)",
                  "(realm|client|user).*?(creation|management|configuration)"
              ]
          },
          "fileTriggers": {
              "pathPatterns": [
                  "**/keycloak/**/*.kt",
                  "**/security/**/*.kt",
                  "**/auth/**/*.kt",
                  "**/config/KeycloakConfig.kt",
                  "**/config/SecurityConfig.kt"
              ],
              "contentPatterns": [
                  "import org.keycloak",
                  "KeycloakBuilder",
                  "RealmRepresentation",
                  "UserRepresentation",
                  "ClientRepresentation",
                  "IdentityProviderRepresentation",
                  "keycloak\\.realm\\(",
                  "keycloak\\.realms\\(\\)"
              ]
          }
      },
      "nuxt-dev-guidelines": {
          "type": "domain",
          "enforcement": "suggest",
          "priority": "high",
          "description": "Nuxt 4 frontend development guidelines with TypeScript, Composition API, file-based routing, auto-imports, server-side rendering, data fetching with useFetch and useAsyncData, SEO and meta tag management with useHead and useSeoMeta, Nitro server engine, and best practices for building performant full-stack web applications",
          "promptTriggers": {
              "keywords": [
                  "Nuxt",
                  "Nuxt 4",
                  "Nuxt.js",
                  "nuxt",
                  "nuxt config",
                  "nuxt.config",
                  "useFetch",
                  "useAsyncData",
                  "useState",
                  "useHead",
                  "useSeoMeta",
                  "definePageMeta",
                  "file-based routing",
                  "auto-import",
                  "auto-imports",
                  "server-side rendering",
                  "SSR",
                  "SSG",
                  "static generation",
                  "Nitro",
                  "nitro",
                  "server directory",
                  "server/api",
                  "API routes",
                  "composables",
                  "nuxt composable",
                  "layouts",
                  "middleware",
                  "route middleware",
                  "pages directory",
                  "SEO",
                  "meta tags",
                  "Open Graph",
                  "og:image",
                  "Twitter Card",
                  "head management",
                  "Nuxt modules",
                  "Nuxt plugins"
              ],
              "intentPatterns": [
                  "(create|add|build|setup).*?(nuxt|page|layout|middleware|API route)",
                  "(fetch|load|get).*?data.*?(nuxt|useFetch|useAsyncData)",
                  "(how to|how do I).*?(nuxt|SSR|server.*?render|fetch.*?data)",
                  "(SEO|meta|head).*?(nuxt|tags|useSeoMeta|useHead)",
                  "(configure|setup).*?(nuxt|nitro|module)",
                  "nuxt.*?(routing|navigation|middleware)",
                  "(server|API).*?(route|endpoint|handler).*?nuxt"
              ]
          },
          "fileTriggers": {
              "pathPatterns": [
                  "front/**/*.vue",
                  "front/pages/**/*.vue",
                  "front/components/**/*.vue",
                  "front/composables/**/*.ts",
                  "front/server/**/*.ts",
                  "front/nuxt.config.ts",
                  "front/app.vue",
                  "app/**/*.vue",
                  "pages/**/*.vue",
                  "server/api/**/*.ts",
                  "server/routes/**/*.ts",
                  "nuxt.config.ts"
              ],
              "pathExclusions": [
                  "**/*.test.ts",
                  "**/*.spec.ts",
                  "**/node_modules/**"
              ],
              "contentPatterns": [
                  "defineNuxtConfig",
                  "useFetch",
                  "useAsyncData",
                  "useLazyFetch",
                  "useLazyAsyncData",
                  "useState",
                  "useHead",
                  "useSeoMeta",
                  "definePageMeta",
                  "defineEventHandler",
                  "useRouter",
                  "useRoute",
                  "navigateTo",
                  "defineNuxtRouteMiddleware"
              ]
          }
      }
  },
  "notes": {
      "enforcement_types": {
          "suggest": "Skill suggestion appears but doesn't block execution",
          "block": "Requires skill to be used before proceeding (guardrail)",
          "warn": "Shows warning but allows proceeding"
      },
      "priority_levels": {
          "critical": "Highest - Always trigger when matched",
          "high": "Important - Trigger for most matches",
          "medium": "Moderate - Trigger for clear matches",
          "low": "Optional - Trigger only for explicit matches"
      },
      "customization": {
          "pathPatterns": "Adjust to match your project structure (blog-api, auth-service, etc.)",
          "keywords": "Add domain-specific terms relevant to your project",
          "intentPatterns": "Use regex for flexible user intent matching"
      }
  }
}