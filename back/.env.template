# Docker container names
DOCKER_DATABASE_CONTAINER_NAME=template_db
DOCKER_PGADMIN_CONTAINER_NAME=pgadmin
DOCKER_BACKEND_CONTAINER_NAME=template_api
DOCKER_KEYCLOAK_CONTAINER_NAME=keycloak

# PgAdmin configuration
PGADMIN_DEFAULT_EMAIL=florentin.burgeat@live.fr
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# PostgreSQL database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=motdepasse
POSTGRES_DB=wishlist_db
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Spring Boot application port (exposed externally)
PORT=8080

# ===================================
# KEYCLOAK CONFIGURATION
# ===================================

# Keycloak container configuration
KEYCLOAK_PORT=8081
KEYCLOAK_HOSTNAME=localhost

# Keycloak admin credentials (change in production!)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak database (uses same PostgreSQL instance)
KEYCLOAK_DB_NAME=keycloak_db

# Keycloak realm configuration
# IMPORTANT: Each fork should have a unique realm name
# Examples: project-template-dev, myproject-prod, acme-staging
KEYCLOAK_REALM_NAME=template-realm

# Keycloak client configuration
KEYCLOAK_FRONTEND_CLIENT_ID=frontend-client
KEYCLOAK_BACKEND_CLIENT_ID=backend-service
KEYCLOAK_BACKEND_CLIENT_SECRET=change-this-secret-in-production

# Keycloak URLs (internal vs external)
# Internal URL (used by backend inside Docker network)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# External URL (used by frontend browser)
KEYCLOAK_EXTERNAL_URL=http://localhost:8081

# Keycloak logging
KEYCLOAK_LOG_LEVEL=INFO

# Keycloak deployment mode (standalone or clustered)
# dev: standalone (single instance, no clustering)
# prod: clustered (multiple instances with Infinispan)
KEYCLOAK_DEPLOYMENT_MODE=standalone


# Spring Boot active profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev
